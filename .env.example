# Valores locales de desarrollo. Copia este archivo a .env, que esta en .gitignore.
#
# Lo leen dos programas distintos:
#   - Docker Compose, por convencion propia, para las variables de PostgreSQL.
#   - Spring Boot, solo con el perfil dev activo, por el spring.config.import
#     de application-dev.properties.
#
# Las pruebas y el jar empaquetado no activan el perfil dev y no leen este archivo.
# En cualquier otro entorno la configuracion llega por variables de entorno reales,
# que tienen mas precedencia que este archivo.

# Docker Compose / PostgreSQL local
POSTGRES_DB=gr_user_db
POSTGRES_PORT=5432

# Spring Boot datasource
DB_URL=jdbc:postgresql://localhost:5432/gr_user_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_SHOW_SQL=false

# JWT (Spring Security)
# Minimo 32 caracteres: con menos, HMAC-SHA256 rechaza la clave y la aplicacion no arranca.
# Genera la tuya y no la compartas:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS (origen del frontend Next.js)
# El frontend de Next.js no necesita estar aqui: su proxy borra el Origin del
# navegador antes de reenviar. Solo hace falta para clientes que llamen directo al 8080.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookies de sesion (access_token y refresh_token son HttpOnly + SameSite=Strict)
# false solo en local, donde no hay HTTPS: con true el navegador descarta las cookies
# y nunca se completa el inicio de sesion. En cualquier entorno desplegado va en true.
COOKIE_SECURE=false
