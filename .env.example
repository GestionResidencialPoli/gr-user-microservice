# Docker Compose / PostgreSQL local
POSTGRES_DB=gr_user_db
POSTGRES_PORT=5432

# Spring Boot datasource
DB_URL=jdbc:postgresql://localhost:5432/gr_user_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_SHOW_SQL=false

# JWT (Spring Security)
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS (origen del frontend Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookies de sesion (access_token y refresh_token son HttpOnly + SameSite=Strict)
# Dejar en true siempre, salvo desarrollo local sin HTTPS.
COOKIE_SECURE=true
